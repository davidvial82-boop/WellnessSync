    {ph:'Strength',rest:'90s\u20132min between letters',items:[
      {st:'1a',n:'Hip thrust or deadlift',sets:4,d:'4\u00d75 @ RPE 8',h:'4\u00d75 @ RPE 6\u20137',log:1,rest:120},
      {st:'1b',n:'Broad jump or KB swing',d:'4\u00d75',h:'4\u00d75',rest:120},
      {st:'1c',n:'Push-up / landmine press',sets:4,d:'4\u00d78',h:'4\u00d78',log:1,rest:120}
    ]},
    {ph:'Structural',rest:'90s between letters',items:[
      {st:'2a',n:'Bulgarian split squat',sets:3,d:'3\u00d78/side',h:'3\u00d78/side',log:1,rest:90},
      {st:'2b',n:'Pull-up',sets:3,d:'3\u00d78',h:'3\u00d78',log:1,rest:90},
      {st:'2c',n:'Loaded carry medley',d:'3\u00d740m',h:'3\u00d740m'}
    ]},
    {ph:'Conditioning',items:[
      {n:'Air-bike intervals',d:'10\u00d7 (15s hard / 45s easy)',h:'10\u00d7 (15s hard / 45s easy)',note:'repeated-effort'}
    ]}
  ]},
  3:{type:'rest',name:'RECOVERY',int:'',desc:'',note:'Optional Zone 2 \u2014 30 min easy bike or walk, or full rest. Mobility welcome.'},
  6:{type:'rest',name:'REST',int:'',desc:'',note:'Full recovery. Walk, eat your protein, sleep.'},
  0:{type:'rest',name:'REST',int:'',desc:'',note:'Full recovery. Walk, eat your protein, sleep.'}
};
var WEEKORDER=[1,2,3,4,5,6,0];

// ---------- 4-WEEK PROGRESSION WAVE (repeatable) ----------
var BLOCK_START=new Date(2026,8,7); // Mon 7 Sep 2026 = wave week 1 (month 0-indexed)
var WAVE={
  1:{th:'Re-groove',dave:'RPE 7',heath:'RPE 5\u20136 \u00b7 technique'},
  2:{th:'Build',dave:'RPE 8',heath:'RPE 6'},
  3:{th:'Peak',dave:'RPE 8\u20139',heath:'RPE 7 (cap)'},
  4:{th:'Deload',dave:'\u221240% vol \u00b7 RPE 6',heath:'\u221240% vol \u00b7 easy'}
};
function waveWeek(){ var w=Math.floor((now-BLOCK_START)/(7*864e5)); return (((w%4)+4)%4)+1; }

// ---------- STATE ----------
var now=new Date(), dow=now.getDay();
var DKEY=DB.dayKey();
var ATH=DB.getProfile();                 // 'dave' or 'heath' — the device profile
var ISDAVE=(ATH==='dave');
var COMPARE=false;                        // coach view: show the other athlete's targets
var selDow=(PROGRAM[dow]&&PROGRAM[dow].type==='lift')?dow:1;
var prog=PROGRAM[selDow];
var WW=waveWeek();
var DRAFT_KEY, draft;
function loadDraft(){ DRAFT_KEY='ath_draft_'+DKEY+'_'+selDow; draft=DB.get(DRAFT_KEY)||{start:null,log:{},check:{}}; }
loadDraft();

function fmt(s){s=Math.max(0,Math.round(s));var m=Math.floor(s/60),x=s%60;return m+':'+(x<10?'0':'')+x;}
function pb(name){return DB.get('pb_'+name)||0;}
function tgt(it){return ISDAVE?it.d:it.h;}
function other(it){return ISDAVE?it.h:it.d;}

function setDeviceProfile(a){ if(a===ATH)return; DB.setProfile(a); location.reload(); }
function paintProfile(){
  document.getElementById('profName').textContent=DB.profileName(ATH);
  document.querySelectorAll('#profSwitch button').forEach(function(b){ b.classList.toggle('on',b.dataset.a===ATH); });
}
function toggleCompare(){ COMPARE=!COMPARE; renderToday(); }
function selectDay(d){ selDow=d; prog=PROGRAM[d]; loadDraft(); initHeader(); renderToday(); switchView('today'); window.scrollTo(0,0); }

function switchView(v){
  ['today','week'].forEach(function(x){
    document.getElementById(x+'View').style.display = x===v?'block':'none';
    document.getElementById('tab-'+x).classList.toggle('active',x===v);
  });
  document.getElementById('finishWrap').style.display = (v==='today'&&prog.type==='lift')?'block':'none';
  if(v==='week') renderWeek();
}

function initHeader(){
  document.getElementById('sessionName').textContent=prog.name;
  document.getElementById('sessionInt').textContent=prog.int||'';
  var meta;
  if(prog.type==='lift') meta='Week '+WW+' \u00b7 '+WAVE[WW].th+' \u2014 '+prog.desc;
  else meta=prog.note||'';
  document.getElementById('sessionMeta').textContent=meta;
  document.getElementById('kicker').textContent=(selDow===dow?'TODAY':DABBR[selDow]+' SESSION')+' \u00b7 '+DB.profileName(ATH).toUpperCase();
}

function phasesFor(pr){ return pr.type==='lift' ? [WARMUP].concat(pr.blocks) : []; }

function weekCount(){
  var back=(now.getDay()+6)%7, c=0;   // days since Monday
  for(var off=-back; off<=0; off++){
    var list=DB.get('workouts_'+DB.dayKey(off))||[];
    list.forEach(function(w){ if(w.type==='athlete') c++; });
  }
  return c;
}

function renderToday(){
  var body=document.getElementById('sessionBody'); body.innerHTML='';
  var top=document.createElement('div'); top.className='topline';
  top.innerHTML='<span class="weekcount">This week \u00b7 <b>'+weekCount()+' / 4</b> sessions</span>'
    +'<span class="chip'+(COMPARE?' on':'')+'" onclick="toggleCompare()">Compare '+(ISDAVE?'Heath':'Dave')+'</span>';
  body.appendChild(top);
  if(prog.type==='rest'){ var r=document.createElement('div'); r.className='rest-day'; r.innerHTML='<div class="big">'+prog.name+'</div><div>'+(prog.note||'')+'</div>'; body.appendChild(r); return; }
  var w=WAVE[WW];
  var ban=document.createElement('div'); ban.className='philosophy';
  ban.innerHTML='Week <b>'+WW+' of 4</b> \u00b7 <b>'+w.th+'</b> \u2014 '+DB.profileName(ATH)+': <b>'+(ISDAVE?w.dave:w.heath)+'</b>.<br>'
    +'Speed &amp; power first, fully fresh. Rest <b>90s\u20132min between letters</b>. Neck every day. Stick every landing.';
  body.appendChild(ban);
  var gi=0;
  phasesFor(prog).forEach(function(phase){
    var ph=document.createElement('div'); ph.className='phase-h';
    ph.innerHTML='<div class="pn">'+phase.ph+'</div>'+(phase.rest?'<div class="pr">'+phase.rest+'</div>':'');
    body.appendChild(ph);
    phase.items.forEach(function(it){ body.appendChild(itemCard(it,gi)); gi++; });
  });
}

function itemCard(it,gi){
  var d=document.createElement('div'); d.className='ex'+(it.pw?' power':'')+(it.log?'':' guided');
  var badge=it.st?'<span class="st-badge">'+it.st+'</span>':'';
  var pbv=it.log?pb(it.n):0, pbTxt=pbv>0?('PB '+pbv+'kg'):'';
  var h='<div class="ex-top"><div class="ex-name">'+badge+it.n+(it.pw?' \u26a1':'')+'</div><div class="ex-pb">'+pbTxt+'</div></div>';
  var cmp=(COMPARE&&other(it)&&other(it)!==tgt(it))?'<span class="cmp"> \u00b7 '+(ISDAVE?'Heath':'Dave')+': '+other(it)+'</span>':'';
  h+='<div class="ex-target">'+tgt(it)+(it.note?'<span class="note-pill">'+it.note+'</span>':'')+cmp+'</div>';
  if(it.log){
    var sets=it.sets||3, log=draft.log[gi]||[];
    h+='<div class="sets">';
    for(var s=0;s<sets;s++){ var l=log[s]||{}, dc=l.done?' done':'';
      h+='<div class="set-row'+dc+'" data-i="'+gi+'" data-s="'+s+'"><span class="set-n">'+(s+1)+'</span>'
        +'<input class="set-w" inputmode="decimal" placeholder="kg" value="'+(l.w||'')+'"><span class="set-x">\u00d7</span>'
        +'<input class="set-r" inputmode="numeric" placeholder="reps" value="'+(l.r||'')+'"><button class="set-done">\u2713</button></div>';
    }
    h+='</div>';
    if(it.rest) h+='<button class="rest-btn" onclick="startRest('+it.rest+')">Start rest \u00b7 '+fmt(it.rest)+'</button>';
  } else {
    var on=draft.check[gi]?' on':'';
    h+='<button class="done-btn'+on+'" data-i="'+gi+'" onclick="toggleDone('+gi+',this'+(it.rest?','+it.rest:'')+')">'+(draft.check[gi]?'\u2713 Done':'Mark done')+'</button>';
    if(it.rest) h+='<button class="rest-btn" onclick="startRest('+it.rest+')">Start rest \u00b7 '+fmt(it.rest)+'</button>';
  }
  d.innerHTML=h;
  if(it.log){
    d.querySelectorAll('.set-row').forEach(function(row){
      var rest=it.rest||0;
      row.querySelector('.set-w').addEventListener('input',function(){saveSet(row);});
      row.querySelector('.set-r').addEventListener('input',function(){saveSet(row);});
      row.querySelector('.set-done').addEventListener('click',function(){row.classList.toggle('done');saveSet(row);if(row.classList.contains('done')&&rest)startRest(rest);});
    });
  }
  return d;
}

function saveSet(row){ if(!draft.start)draft.start=Date.now(); var i=+row.dataset.i,s=+row.dataset.s; draft.log[i]=draft.log[i]||[]; draft.log[i][s]={w:row.querySelector('.set-w').value,r:row.querySelector('.set-r').value,done:row.classList.contains('done')}; DB.set(DRAFT_KEY,draft); }
function toggleDone(i,btn,rest){ if(!draft.start)draft.start=Date.now(); draft.check[i]=!draft.check[i]; btn.classList.toggle('on',draft.check[i]); btn.textContent=draft.check[i]?'\u2713 Done':'Mark done'; DB.set(DRAFT_KEY,draft); if(draft.check[i]&&rest)startRest(rest); }

// ---------- REST TIMER ----------
function startRest(sec){ DB.set('rest_end',Date.now()+sec*1000); requestNotify(); tickRest(); }
function addRest(sec){ var e=DB.get('rest_end')||Date.now(); DB.set('rest_end',Math.max(Date.now(),e)+sec*1000); tickRest(); }
function stopRest(){ DB.set('rest_end',null); document.getElementById('restBar').classList.remove('show'); }
var restRang=false;
function tickRest(){ var end=DB.get('rest_end'),bar=document.getElementById('restBar'); if(!end){bar.classList.remove('show');return;} bar.classList.add('show');
  var left=Math.round((end-Date.now())/1000),inner=document.getElementById('restInner');
  if(left<=0){document.getElementById('restTime').textContent='GO';document.getElementById('restLabel').textContent='Rest over';inner.classList.add('over');if(!restRang){restRang=true;buzz();}}
  else{document.getElementById('restTime').textContent=fmt(left);document.getElementById('restLabel').textContent='Rest';inner.classList.remove('over');restRang=false;}
}
function requestNotify(){ try{ if('Notification'in window&&Notification.permission==='default')Notification.requestPermission(); }catch(e){} }
function buzz(){ try{ if(navigator.vibrate)navigator.vibrate([200,100,200]); var A=new (window.AudioContext||window.webkitAudioContext)(),o=A.createOscillator(),g=A.createGain(); o.connect(g);g.connect(A.destination);o.frequency.value=880;g.gain.value=0.2;o.start();o.stop(A.currentTime+0.3); }catch(e){} }

// ---------- FINISH ----------
function finishSession(){
  var dur=draft.start?Math.max(1,Math.round((Date.now()-draft.start)/60000)):0;
  var gi=0;
  phasesFor(prog).forEach(function(phase){ phase.items.forEach(function(it){
    if(it.log){ var log=draft.log[gi]||[],best=0; log.forEach(function(l){if(l&&l.done){var wv=parseFloat(l.w)||0;if(wv>best)best=wv;}}); if(best>pb(it.n))DB.set('pb_'+it.n,best); }
    gi++;
  });});
  var label=prog.name+' '+(prog.int||'');
  var entry={name:label,type:'athlete',day:selDow,duration:dur,log:draft.log,check:draft.check,startTime:draft.start?new Date(draft.start).toISOString():null,endTime:new Date().toISOString()};
  var wList=DB.get('workouts_'+DKEY)||[]; wList.push(entry); DB.set('workouts_'+DKEY,wList);
  DB.set(DRAFT_KEY,null); DB.set('rest_end',null);
  var b=document.getElementById('finishBtn'); b.textContent='Session Saved \u2713'; b.classList.add('saved');
  setTimeout(function(){location.href='index.html';},900);
}

// ---------- WEEK ----------
function renderWeek(){
  var el=document.getElementById('weekList'); el.innerHTML='';
  var doneDays=(DB.get('workouts_'+DKEY)||[]).filter(function(w){return w.type==='athlete';}).map(function(w){return w.day;});
  WEEKORDER.forEach(function(d){ var pr=PROGRAM[d], today=d===dow, sel=d===selDow, done=doneDays.indexOf(d)>-1&&pr.type==='lift';
    var tag=pr.type==='lift'?'LIFT':'REST';
    var detail=pr.type==='lift'?pr.desc:(pr.note||'Full recovery');
    var badge=done?'<span class="wk-done">\u2713 done</span>':(today?'<span class="wk-tod">today</span>':'');
    var nm=pr.type==='lift'?(pr.name+' \u00b7 '+pr.int):pr.name;
    el.innerHTML+='<div class="wk-row'+(sel?' sel':'')+(today?' today':'')+'" onclick="selectDay('+d+')"><div class="wk-day">'+DABBR[d]+'</div>'
      +'<div class="wk-body"><div class="wk-name">'+nm+' '+badge+'</div><div class="wk-int">'+detail+'</div></div>'
      +'<div class="wk-tag tag-'+tag.toLowerCase()+'">'+tag+'</div></div>';
  });
}

function loop(){ tickRest(); }
document.addEventListener('visibilitychange',function(){if(!document.hidden)loop();});
window.addEventListener('focus',loop);
setInterval(loop,500);
paintProfile(); initHeader(); renderToday(); switchView('today'); loop();
</script>
</body>
</html>
